# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

# Force these files to always have LF (Unix) line endings on checkout.
# This prevents Prettier/ESLint from complaining about CRLF on Windows.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
